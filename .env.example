# Copy this file to .env.local and fill in the values.

# PostgreSQL connection (defaults match docker-compose.yml)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=erp_admin
PGPASSWORD=erp_dev_password
PGDATABASE=erp_database

# Business time zone for "today", due dates and timestamps (IANA name). Default: UTC
NEXT_PUBLIC_APP_TIMEZONE=Europe/Berlin

# Admin panel password (/admin) — at least 10 characters. Without it the admin panel is disabled.
ADMIN_PASSWORD=

# Optional: separate key for signing admin sessions (at least 32 characters).
# If empty, it is derived from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# true when the site runs over HTTPS (cookies become Secure)
COOKIE_SECURE=false

# Public URL of the app (used in email links)
APP_URL=http://localhost:3000
# App name shown in the UI and emails (optional)
NEXT_PUBLIC_APP_NAME=Firmax
# Source code link on the landing page (optional)
NEXT_PUBLIC_REPO_URL=https://github.com/hamidaka428/firmax

# --- Email (SMTP) — email confirmation, password reset, sending invoices ---
# Works with Brevo, Resend, Mailgun, SendGrid, Google Workspace, etc.
# Without SMTP_HOST, emails are not sent — the links are printed to the server console (for development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465
SMTP_SECURE=
# Sender, e.g.: Firmax <no-reply@example.com>
MAIL_FROM=

# --- Recurring invoices ---
# Secret (at least 16 characters) for /api/cron/recurring — call it once a day with
#   Authorization: Bearer <CRON_SECRET>
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
